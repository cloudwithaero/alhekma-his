import frappe
from healthcare.healthcare.utils import get_children as healthcare_get_children


@frappe.whitelist()
def get_root(
    doctype="Healthcare Service Unit",
    parent=None,
    company=None,
    is_root=False,
):
    if doctype != "Healthcare Service Unit":
        return []

    # When the tree asks for children, use the standard Healthcare logic.
    if parent:
        return healthcare_get_children(
            doctype=doctype,
            parent=parent,
            company=company,
            is_root=False,
        )

    # Initial tree root.
    if not company:
        return []

    root = frappe.db.get_value(
        "Healthcare Service Unit",
        {
            "company": company,
            "parent_healthcare_service_unit": ["is", "not set"],
        },
        "name",
        order_by="lft asc",
    )

    if not root:
        return []

    return [{"value": root}]

